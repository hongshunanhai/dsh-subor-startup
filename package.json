{
  "name": "dsh-subor-startup",
  "version": "0.1.0",
  "description": "Subor-style CRT boot animation for DeepSeek Harness: the tube powers on, the pixel logo drops in with a line of \"DeepSeek, endless fun\", then 108 classic FC game windows fill the screen along a snake-like inward spiral, before a white flash fades into the app. Auto-plays, skippable, zero config.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "startup",
    "splash",
    "boot-animation",
    "subor",
    "xiaobawang",
    "fc",
    "retro",
    "pixel-art"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "public",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README.zh-CN.md",
    "locale/*.json",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "hongshunanhai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hongshunanhai/dsh-subor-startup.git"
  },
  "homepage": "https://github.com/hongshunanhai/dsh-subor-startup#readme",
  "bugs": {
    "url": "https://github.com/hongshunanhai/dsh-subor-startup/issues"
  }
}
